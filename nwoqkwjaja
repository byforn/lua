-- ========== AUTO CLAIM SCANNER ==========
task.spawn(function()
	local function isClaim(str)
		if type(str) ~= "string" then return false end
		return str:lower():gsub("%s+", ""):find("claim") ~= nil
	end

	local function click(obj)
		if not obj or not obj.Parent then return end
		pcall(function()
			obj.Visible = true
			if obj:IsA("GuiObject") then obj.Active = true end
		end)
		if typeof(firesignal) == "function" then
			pcall(function()
				if obj:IsA("GuiButton") then
					firesignal(obj.MouseButton1Click)
					firesignal(obj.Activated)
				end
			end)
		end
		pcall(function()
			local abs = obj.AbsolutePosition
			local size = obj.AbsoluteSize
			if abs and size and size.X > 5 and size.Y > 5 then
				local x = abs.X + size.X / 2
				local y = abs.Y + size.Y / 2
				VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
				task.wait(0.04)
				VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
			end
		end)
	end

	while true do
		task.wait(0.4)
		local pg = localPlayer:FindFirstChild("PlayerGui")
		if not pg then continue end
		for _, d in ipairs(pg:GetDescendants()) do
			if (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) and isClaim(d.Text) then
				click(d)
				if d.Parent and (d.Parent:IsA("TextButton") or d.Parent:IsA("ImageButton")) then
					click(d.Parent)
				end
			elseif (d:IsA("TextButton") or d:IsA("ImageButton")) and (isClaim(d.Name) or (d:FindFirstChildWhichIsA("TextLabel") and isClaim(d:FindFirstChildWhichIsA("TextLabel").Text))) then
				click(d)
			end
		end
	end
end)

