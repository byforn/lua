-- ========== TARGET SELECTION (Lowest HP, lock until death) ==========
local function isValidTarget(player)
	if not player or player == localPlayer or not player.Parent then return false end
	local char = player.Character
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local torso = char:FindFirstChild("Torso")
	if not hum or not hrp or not torso then return false end
	if hum.Health <= 0 then return false end
	if torso.Transparency == 1 then return false end
	if char:FindFirstChildWhichIsA("ForceField") then return false end
	if char:FindFirstChild("AbsoluteImmortal") then return false end
	if char:FindFirstChild("Counter") then return false end
	local pos = hrp.Position
	if pos.X < -500 or pos.X > 800 or pos.Z < -600 or pos.Z > 700 then return false end
	return true
end

local function getLowestHPTarget()
	-- Keep locked target if still valid
	if lockedTarget and isValidTarget(lockedTarget) then
		return lockedTarget
	end

	local best, lowest = nil, math.huge
	for _, plr in ipairs(Players:GetPlayers()) do
		if isValidTarget(plr) then
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health < lowest then
				lowest = hum.Health
				best = plr
			end
		end
	end
	lockedTarget = best
	return best
end

