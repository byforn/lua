-- Extreme Deep Void Positions
local TARGET_VOID_Y = -500000
local BASEPLATE_Y = -500020

local isAtVoid = false
local isProcessing = false
local savedPreVoidCFrame = nil

-- Disable TSB Void Death Boundary locally
local function unlockVoidBoundary()
	pcall(function()
		Workspace.FallenPartsDestroyHeight = 0/0
	end)
end
unlockVoidBoundary()

Workspace:GetPropertyChangedSignal("FallenPartsDestroyHeight"):Connect(function()
	if Workspace.FallenPartsDestroyHeight == Workspace.FallenPartsDestroyHeight then
		unlockVoidBoundary()
	end
end)

-- Create Deep Void Baseplate
local voidPart = Workspace:FindFirstChild("GlobalVoidBaseplate")
if not voidPart then
	voidPart = Instance.new("Part")
	voidPart.Name = "GlobalVoidBaseplate"
	voidPart.Size = Vector3.new(8192, 20, 8192)
	voidPart.CFrame = CFrame.new(0, BASEPLATE_Y, 0)
	voidPart.Anchored = true
	voidPart.Transparency = 0.4
	voidPart.CanCollide = true
	voidPart.Parent = Workspace
else
	voidPart.Size = Vector3.new(8192, 20, 8192)
	voidPart.CFrame = CFrame.new(0, BASEPLATE_Y, 0)
end

-- Teleport Helper: Overrides character velocity to prevent anti-cheat pullbacks
local function forceTeleport(hrp, targetCFrame)
	if not hrp then return end
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	hrp.CFrame = targetCFrame
end

-- Void Health & Position Safeguard
local savedHealth = 100
local function protectFromVoid(character)
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 3)
	local rootPart = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 3)
	if not humanoid or not rootPart then return end

	savedHealth = humanoid.Health

	local renderConnection
	renderConnection = RunService.RenderStepped:Connect(function()
		if not character or not character.Parent then
			renderConnection:Disconnect()
			return
		end
		local rPart = character:FindFirstChild("HumanoidRootPart")
		if rPart then
			if isAtVoid then
				rPart.AssemblyLinearVelocity = Vector3.zero
			end
			savedHealth = humanoid.Health
			voidPart.CFrame = CFrame.new(rPart.Position.X, BASEPLATE_Y, rPart.Position.Z)
		end
	end)

	humanoid.HealthChanged:Connect(function(newHealth)
		local rPart = character:FindFirstChild("HumanoidRootPart")
		if newHealth <= 0 and rPart and rPart.CFrame.Y <= 0 then
			humanoid.Health = savedHealth
		end
	end)
end

protectFromVoid(localPlayer.Character)
localPlayer.CharacterAdded:Connect(function(newCharacter)
	task.wait(0.1)
	protectFromVoid(newCharacter)
end)

-- Return player back to initial surface position
local function returnToOriginalPosition()
	local returnPosition = savedPreVoidCFrame
	isAtVoid = false

	if returnPosition then
		savedPreVoidCFrame = nil
		local character = localPlayer.Character
		if character then
			local hrp = character:FindFirstChild("HumanoidRootPart")
			if hrp then
				forceTeleport(hrp, returnPosition)
			end
		end
	end
end

-- Fallback Target in Live Folder
local function getWeakestDummyTarget()
	local liveFolder = Workspace:FindFirstChild("Live")
	if liveFolder then
		for _, child in ipairs(liveFolder:GetChildren()) do
			if child:IsA("Model") and string.lower(child.Name) == "weakest dummy" then
				local hrp = child:FindFirstChild("HumanoidRootPart")
				local hum = child:FindFirstChildOfClass("Humanoid")
				if hrp and hum and hum.Health > 0 then
					return hrp
				end
			end
		end
	end
	return nil
end

-- Collect Targets
local function getSweepTargets()
	local targets = {}

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer and player.Character then
			local hrp = player.Character:FindFirstChild("HumanoidRootPart")
			local hum = player.Character:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				table.insert(targets, hrp)
			end
		end
	end

	if #targets == 0 then
		local dummyHRP = getWeakestDummyTarget()
		if dummyHRP then
			table.insert(targets, dummyHRP)
		end
	end

	return targets
end

-- Checks Backpack and Character for matching Tool
local function getSweepTool()
	local backpack = localPlayer:FindFirstChildOfClass("Backpack")
	local character = localPlayer.Character

	local containers = {}
	if backpack then table.insert(containers, backpack) end
	if character then table.insert(containers, character) end

	for _, container in ipairs(containers) do
		for _, item in ipairs(container:GetChildren()) do
			if item:IsA("Tool") then
				local itemName = string.lower(item.Name)
				for _, sweepText in ipairs(SWEEP_TARGET_TEXTS) do
					if string.find(itemName, sweepText, 1, true) then
						return item
					end
				end
			end
		end
	end
	return nil
end

-- Execution Sequence
local function executeForcedSweepSequence(tool)
	if isProcessing then return end
	isProcessing = true

	local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
	local humanoidRootPart = character:WaitForChild("HumanoidRootPart", 5)
	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if humanoidRootPart and humanoid and humanoid.Health > 0 then
		savedPreVoidCFrame = humanoidRootPart.CFrame

		-- Force equip and activate tool
		if tool.Parent ~= character then
			humanoid:EquipTool(tool)
		end
		tool:Activate()

		-- Teleport through all targets in the same frame
		local targets = getSweepTargets()
		for _, targetHRP in ipairs(targets) do
			if targetHRP and targetHRP.Parent and humanoid.Health > 0 then
				forceTeleport(humanoidRootPart, targetHRP.CFrame)
			end
		end

		-- Wait 0.3 seconds before sending player to void baseplate
		task.wait(0.3)

		if humanoid.Health > 0 then
			isAtVoid = true
			forceTeleport(humanoidRootPart, CFrame.new(humanoidRootPart.Position.X, TARGET_VOID_Y, humanoidRootPart.Position.Z))
		end
	end

	-- Monitor tool existence. Once tool disappears, wait 6 seconds and stop execution.
	while true do
		task.wait(0.1)
		local currentTool = getSweepTool()
		if not currentTool then
			break
		end
	end

	-- Apply 6-second cooldown after tool disappears
	task.wait(6)

	if isAtVoid then
		returnToOriginalPosition()
	end

	isProcessing = false
end

-- Core Execution Loop
task.spawn(function()
	while true do
		if not isProcessing then
			local sweepTool = getSweepTool()
			if sweepTool then
				executeForcedSweepSequence(sweepTool)
			else
				task.wait(0.05)
			end
		else
			task.wait(0.05)
		end
	end
end)

localPlayer.CharacterAdded:Connect(function()
	isAtVoid = false
	savedPreVoidCFrame = nil
	isProcessing = false
end)
